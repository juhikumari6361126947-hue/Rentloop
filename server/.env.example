PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/rental_marketplace
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173

# Seedable admin credentials used by /api/auth/admin/login
ADMIN_EMAIL=admin@rentals.local
ADMIN_PASSWORD=Admin@12345

# Cloudinary upload settings (leave blank to store images locally)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
